const express = require("express");
const cors = require("cors");
const crypto = require("crypto");

const app = express();

const PORT = Number(process.env.PORT || 3000);

// عنوان سيرفر Godot الحقيقي.
// غيّره في استضافة السيرفر إلى عنوان سيرفر Godot Dedicated Server.
const GODOT_SERVER_HOST =
    process.env.GODOT_SERVER_HOST || "127.0.0.1";

const GODOT_SERVER_PORT =
    Number(process.env.GODOT_SERVER_PORT || 7777);

const MAX_PLAYERS = 6;
const MAX_HUMANS = 4;
const MAX_MONSTERS = 2;

app.use(cors());
app.use(express.json({ limit: "64kb" }));

// =====================================================
// بيانات الغرف
// =====================================================

const rooms = new Map();

// =====================================================
// أدوات مساعدة
// =====================================================

function makeId(prefix) {
    return `${prefix}_${crypto.randomBytes(5).toString("hex")}`;
}

function cleanName(name) {
    if (typeof name !== "string") {
        return "Player";
    }

    const value = name.trim().slice(0, 20);

    return value || "Player";
}

function getRoom(roomId) {
    return rooms.get(roomId) || null;
}

function getPlayer(room, playerId) {
    return room.players.find(
        player => player.playerId === playerId
    ) || null;
}

function getHumans(room) {
    return room.players.filter(
        player => player.role === "human"
    );
}

function getMonsters(room) {
    return room.players.filter(
        player => player.role === "monster"
    );
}

// =====================================================
// البيانات التي يسمح للعميل برؤيتها
// =====================================================

function publicRoom(room) {
    return {
        roomId: room.roomId,

        name: room.name,

        ownerId: room.ownerId,

        state: room.state,

        maxPlayers: MAX_PLAYERS,

        humans: getHumans(room).length,

        monsters: getMonsters(room).length,

        playerCount: room.players.length,

        readyCount: room.players.filter(
            player => player.ready
        ).length,

        players: room.players.map(player => ({
            playerId: player.playerId,

            name: player.name,

            role: player.role,

            ready: player.ready
        }))
    };
}

// =====================================================
// شروط بداية المباراة
// =====================================================

function canStart(room) {

    if (room.players.length !== MAX_PLAYERS) {
        return false;
    }

    if (getHumans(room).length !== MAX_HUMANS) {
        return false;
    }

    if (getMonsters(room).length !== MAX_MONSTERS) {
        return false;
    }

    if (!room.players.every(player => player.ready)) {
        return false;
    }

    return true;
}

// =====================================================
// الصفحة الرئيسية
// =====================================================

app.get("/", (req, res) => {

    res.json({
        success: true,

        server: "NIGHTMARE ONLINE Lobby Server",

        status: "online",

        rooms: rooms.size,

        limits: {
            players: MAX_PLAYERS,
            humans: MAX_HUMANS,
            monsters: MAX_MONSTERS
        },

        godot: {
            host: GODOT_SERVER_HOST,
            port: GODOT_SERVER_PORT,
            protocol: "ENet/UDP"
        }
    });
});

// =====================================================
// فحص السيرفر
// =====================================================

app.get("/api/health", (req, res) => {

    res.json({
        success: true,

        status: "online",

        rooms: rooms.size,

        time: new Date().toISOString()
    });
});

// =====================================================
// قائمة الغرف
// =====================================================

app.get("/api/rooms", (req, res) => {

    const roomList = [...rooms.values()]
        .filter(room => room.state === "waiting")
        .map(publicRoom);

    res.json({
        success: true,

        rooms: roomList
    });
});

// =====================================================
// إنشاء غرفة
// =====================================================

app.post("/api/rooms", (req, res) => {

    const playerId =
        String(req.body.playerId || "").trim();

    if (!playerId) {

        return res.status(400).json({
            success: false,
            message: "playerId مطلوب."
        });
    }

    const room = {

        roomId: makeId("ROOM"),

        name: cleanName(
            req.body.name || "غرفة الرعب"
        ),

        ownerId: playerId,

        state: "waiting",

        createdAt: Date.now(),

        players: [

            {
                playerId: playerId,

                name: cleanName(
                    req.body.playerName || "Host"
                ),

                role: null,

                ready: false
            }

        ]
    };

    rooms.set(room.roomId, room);

    res.status(201).json({

        success: true,

        message: "تم إنشاء الغرفة بنجاح.",

        room: publicRoom(room)
    });
});

// =====================================================
// دخول غرفة
// =====================================================

app.post("/api/rooms/:roomId/join", (req, res) => {

    const room = getRoom(req.params.roomId);

    if (!room) {

        return res.status(404).json({
            success: false,
            message: "الغرفة غير موجودة."
        });
    }

    if (room.state !== "waiting") {

        return res.status(400).json({
            success: false,
            message: "المباراة بدأت بالفعل."
        });
    }

    const playerId =
        String(req.body.playerId || "").trim();

    if (!playerId) {

        return res.status(400).json({
            success: false,
            message: "playerId مطلوب."
        });
    }

    const existingPlayer =
        getPlayer(room, playerId);

    if (existingPlayer) {

        return res.json({
            success: true,
            message: "اللاعب موجود بالفعل.",
            room: publicRoom(room)
        });
    }

    if (room.players.length >= MAX_PLAYERS) {

        return res.status(400).json({
            success: false,
            message: "الغرفة ممتلئة 6/6."
        });
    }

    room.players.push({

        playerId: playerId,

        name: cleanName(
            req.body.playerName
        ),

        role: null,

        ready: false
    });

    res.json({

        success: true,

        message: "تم دخول الغرفة.",

        room: publicRoom(room)
    });
});

// =====================================================
// اختيار Human / Monster
// =====================================================

app.post("/api/rooms/:roomId/role", (req, res) => {

    const room = getRoom(req.params.roomId);

    if (!room) {

        return res.status(404).json({
            success: false,
            message: "الغرفة غير موجودة."
        });
    }

    if (room.state !== "waiting") {

        return res.status(400).json({
            success: false,
            message: "لا يمكن تغيير الدور بعد بداية المباراة."
        });
    }

    const playerId =
        String(req.body.playerId || "").trim();

    const role = req.body.role;

    if (role !== "human" && role !== "monster") {

        return res.status(400).json({
            success: false,
            message: "الدور يجب أن يكون human أو monster."
        });
    }

    const player =
        getPlayer(room, playerId);

    if (!player) {

        return res.status(404).json({
            success: false,
            message: "اللاعب غير موجود في الغرفة."
        });
    }

    const humans =
        getHumans(room).length;

    const monsters =
        getMonsters(room).length;

    // اللاعب يريد Human
    if (
        role === "human" &&
        player.role !== "human" &&
        humans >= MAX_HUMANS
    ) {

        return res.status(400).json({
            success: false,
            message: "فريق البشر ممتلئ 4/4."
        });
    }

    // اللاعب يريد Monster
    if (
        role === "monster" &&
        player.role !== "monster" &&
        monsters >= MAX_MONSTERS
    ) {

        return res.status(400).json({
            success: false,
            message: "فريق الوحوش ممتلئ 2/2."
        });
    }

    player.role = role;

    // عند تغيير الدور يجب إعادة Ready
    player.ready = false;

    res.json({

        success: true,

        assignedRole: role,

        room: publicRoom(room)
    });
});

// =====================================================
// Ready / Not Ready
// =====================================================

app.post("/api/rooms/:roomId/ready", (req, res) => {

    const room = getRoom(req.params.roomId);

    if (!room) {

        return res.status(404).json({
            success: false,
            message: "الغرفة غير موجودة."
        });
    }

    if (room.state !== "waiting") {

        return res.status(400).json({
            success: false,
            message: "المباراة بدأت بالفعل."
        });
    }

    const playerId =
        String(req.body.playerId || "").trim();

    const player =
        getPlayer(room, playerId);

    if (!player) {

        return res.status(404).json({
            success: false,
            message: "اللاعب غير موجود."
        });
    }

    if (!player.role) {

        return res.status(400).json({
            success: false,
            message: "اختر Human أو Monster أولاً."
        });
    }

    player.ready =
        Boolean(req.body.ready);

    res.json({

        success: true,

        ready: player.ready,

        room: publicRoom(room)
    });
});

// =====================================================
// معلومات غرفة واحدة
// =====================================================

app.get("/api/rooms/:roomId", (req, res) => {

    const room =
        getRoom(req.params.roomId);

    if (!room) {

        return res.status(404).json({
            success: false,
            message: "الغرفة غير موجودة."
        });
    }

    res.json({

        success: true,

        room: publicRoom(room)
    });
});

// =====================================================
// Start Match
// =====================================================

app.post("/api/rooms/:roomId/start", (req, res) => {

    const room =
        getRoom(req.params.roomId);

    if (!room) {

        return res.status(404).json({
            success: false,
            message: "الغرفة غير موجودة."
        });
    }

    const playerId =
        String(req.body.playerId || "").trim();

    // فقط صاحب الغرفة يبدأ المباراة
    if (room.ownerId !== playerId) {

        return res.status(403).json({
            success: false,
            message: "فقط صاحب الغرفة يستطيع الضغط على Start."
        });
    }

    if (room.state !== "waiting") {

        return res.status(400).json({
            success: false,
            message: "المباراة بدأت مسبقاً."
        });
    }

    if (!canStart(room)) {

        const humans =
            getHumans(room).length;

        const monsters =
            getMonsters(room).length;

        const ready =
            room.players.filter(
                player => player.ready
            ).length;

        return res.status(400).json({

            success: false,

            message:
                "لا يمكن بدء المباراة. الشروط غير مكتملة.",

            requirements: {

                players:
                    `${room.players.length}/${MAX_PLAYERS}`,

                humans:
                    `${humans}/${MAX_HUMANS}`,

                monsters:
                    `${monsters}/${MAX_MONSTERS}`,

                ready:
                    `${ready}/${MAX_PLAYERS}`
            }
        });
    }

    // تحويل الغرفة إلى Playing
    room.state = "playing";

    room.startedAt = Date.now();

    // بيانات سيرفر Godot
    const godot = {

        host: GODOT_SERVER_HOST,

        port: GODOT_SERVER_PORT,

        protocol: "ENet/UDP",

        roomId: room.roomId
    };

    res.json({

        success: true,

        message: "بدأت المباراة.",

        roomId: room.roomId,

        godot: godot,

        players: room.players.map(
            player => ({

                playerId:
                    player.playerId,

                name:
                    player.name,

                role:
                    player.role
            })
        )
    });
});

// =====================================================
// بيانات اتصال اللاعب بسيرفر Godot
// =====================================================

app.get(
    "/api/rooms/:roomId/connect-info",
    (req, res) => {

        const room =
            getRoom(req.params.roomId);

        if (!room) {

            return res.status(404).json({
                success: false,
                message: "الغرفة غير موجودة."
            });
        }

        if (room.state !== "playing") {

            return res.status(400).json({
                success: false,
                message: "المباراة لم تبدأ بعد."
            });
        }

        const playerId =
            String(
                req.query.playerId || ""
            ).trim();

        const player =
            getPlayer(room, playerId);

        if (!player) {

            return res.status(403).json({
                success: false,
                message:
                    "اللاعب ليس عضواً في هذه الغرفة."
            });
        }

        res.json({

            success: true,

            roomId: room.roomId,

            player: {

                playerId:
                    player.playerId,

                name:
                    player.name,

                role:
                    player.role
            },

            godot: {

                host:
                    GODOT_SERVER_HOST,

                port:
                    GODOT_SERVER_PORT,

                protocol:
                    "ENet/UDP"
            }
        });
    }
);

// =====================================================
// مغادرة الغرفة
// =====================================================

app.post(
    "/api/rooms/:roomId/leave",
    (req, res) => {

        const room =
            getRoom(req.params.roomId);

        if (!room) {

            return res.status(404).json({
                success: false,
                message: "الغرفة غير موجودة."
            });
        }

        const playerId =
            String(
                req.body.playerId || ""
            ).trim();

        const index =
            room.players.findIndex(
                player =>
                    player.playerId === playerId
            );

        if (index === -1) {

            return res.status(404).json({
                success: false,
                message: "اللاعب غير موجود."
            });
        }

        const wasOwner =
            room.ownerId === playerId;

        room.players.splice(index, 1);

        // إذا لم يبقَ لاعب نحذف الغرفة
        if (room.players.length === 0) {

            rooms.delete(room.roomId);

            return res.json({

                success: true,

                message: "تم حذف الغرفة."
            });
        }

        // إذا خرج صاحب الغرفة
        // تنتقل الملكية للاعب التالي
        if (wasOwner) {

            room.ownerId =
                room.players[0].playerId;

            room.players[0].ready = false;
        }

        res.json({

            success: true,

            room: publicRoom(room)
        });
    }
);

// =====================================================
// معالجة الأخطاء
// =====================================================

app.use((err, req, res, next) => {

    console.error(err);

    res.status(500).json({

        success: false,

        message: "حدث خطأ داخلي في السيرفر."
    });
});

